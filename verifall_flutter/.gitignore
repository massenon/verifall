# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Verif'All ------------------------------------------------------------
# Les fichiers de configuration par environnement ne sont JAMAIS versionnes :
# ils portent l'adresse des serveurs et le jeton de recette. Seul
# `config/exemple.json` l'est, et il ne contient aucune valeur reelle.
config/*.json
!config/exemple.json

# Les polices sont des ressources locales sous licence : elles se deposent, elles
# ne se commitent pas tant que la licence n'a pas ete tranchee.
assets/fonts/*.ttf
assets/fonts/*.otf

# Signature Android — « la perdre, c'est perdre la capacite de mettre a jour
# l'application » (07-LIVRAISON 7.1).
android/key.properties
*.jks
*.keystore
